set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY robo_top_level
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:41:27  FEBRUARY 25, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name VERILOG_FILE rtl/robo_top_level.v
set_global_assignment -name VERILOG_FILE rtl/motor_controller.v
set_global_assignment -name VERILOG_FILE rtl/ultrasonic.v
set_global_assignment -name VERILOG_FILE rtl/pwd_generator.v
set_global_assignment -name VERILOG_FILE rtl/clk_divider.v
set_global_assignment -name VERILOG_FILE rtl/encoder.v
set_global_assignment -name VERILOG_FILE rtl/uart_tx.v
set_global_assignment -name VERILOG_FILE rtl/uart_rx.v
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH stage_2 -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME stage_1 -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id stage_1
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_stage_1 -section_id stage_1
set_global_assignment -name EDA_TEST_BENCH_FILE tb/stage_1.v -section_id stage_1
set_global_assignment -name EDA_TEST_BENCH_NAME stage_2 -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id stage_2
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_stage_2 -section_id stage_2
set_global_assignment -name EDA_TEST_BENCH_FILE tb/stage_2.v -section_id stage_2
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# Clock & Reset
set_location_assignment PIN_R8 -to CLOCK_50
set_location_assignment PIN_J15 -to KEY[0]
set_location_assignment PIN_E1 -to KEY[1]

# LEDs
set_location_assignment PIN_A15 -to LED[0]
set_location_assignment PIN_A13 -to LED[1]
set_location_assignment PIN_B13 -to LED[2]
set_location_assignment PIN_A11 -to LED[3]
set_location_assignment PIN_D1 -to LED[4]
set_location_assignment PIN_F3 -to LED[5]
set_location_assignment PIN_B1 -to LED[6]
set_location_assignment PIN_L3 -to LED[7]

# HC-SR04 — echo on INPUT-ONLY pins, trig on bidirectional pins
set_location_assignment PIN_A8 -to echo_left
set_location_assignment PIN_B8 -to echo_front
set_location_assignment PIN_A2 -to echo_right
set_location_assignment PIN_D3 -to trig_left
set_location_assignment PIN_C3 -to trig_front
set_location_assignment PIN_A3 -to trig_right

# TB6612FNG - Channel A (Left Motor)
set_location_assignment PIN_B3 -to motor_AIN1
set_location_assignment PIN_B4 -to motor_AIN2
set_location_assignment PIN_A4 -to motor_PWMA

# TB6612FNG - Channel B (Right Motor)
set_location_assignment PIN_B5 -to motor_BIN1
set_location_assignment PIN_A5 -to motor_BIN2
set_location_assignment PIN_D5 -to motor_PWMB

# TB6612FNG - Standby (tie HIGH via FPGA GPIO)
set_location_assignment PIN_B6 -to motor_STBY

# HW-870 IR Sensor (maze end detection) - digital output
set_location_assignment PIN_A6 -to ir_maze_end

# UART to ESP32
set_location_assignment PIN_A7 -to uart_tx_out
set_location_assignment PIN_B7 -to uart_rx_in

# I/O Standard
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top